ZOOM_EX_SOLENOID=Solenoide y diodo de protección
ZOOM_EX_STEPPER=Motor paso a paso
ZOOM_EX_SHAFT_SENSORS=Sensores de eje
ZOOM_EX_BELTS=Correas y cadenas
