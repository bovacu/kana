// Sketching's words, one block per language (RDE's localization format: a
// LANGUAGE: line, then ID=text lines). Every block has every id of
// src/text_ids.h; both are made by apps/sketching/tools/strings.py: edit it, not
// them. {0}, {1}... are placeholders, {0,plural, one{...} other{...}} counts
// (# the number); an ASCII apostrophe quotes the next character, so write the
// typographic one (U+2019).

// English
EN-US:
@plural = n != 1
FINISH=Finish
CLOSE=Close
MORE_MENU=More
READ_CLOSE_IN=Close ({0})
CANCEL=Cancel
DELETE=Delete
SAVE=Save
RENAME=Rename
UNDO=Undo
REDO=Redo
OF_N={0} of {1}
TOOL_FINGER=Finger
FINGER_ON=Your finger writes: two fingers move the page
FINGER_OFF=The Apple Pencil writes: your fingers move the page
FINGER_OFF_ANDROID=The stylus writes: your fingers move the page
TOOL_DRAW=Draw
TOOL_MARK=Marker
TOOL_ERASE=Erase
TOOL_LASSO=Lasso
TOOL_CLEAR=Clear the page
TOOL_COLOR=Colour
TOOL_PAGE=Page
TOOL_SCREEN=Screen
TOOL_PAPER=Paper
TOOL_ROTATE=Rotate
TOOL_RESET=Reset the view
