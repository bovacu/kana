# Sketching: the deep-zoom canvas with everything in it, the developer's build.
# Everything RDE's builder needs to make it, on every platform. The ten apps' files are alike line for line;
# docs/architecture.md, "The builds", says why each line is there. Build through tools/build/app.sh, which gives the
# builder the version from src/version.h (its one place) and builds whisper.cpp when it is missing:
#   zsh tools/build/app.sh sketching [command] [profile]      e.g. sketching, sketching run sim
# Paths are from this file's folder.

[project]
# Its description, and every file of its layers: the drawing core, the canvas, the simulation.
sources = sketching.c
          ../../fude/drawing/*/*.c ../../fude/drawing/*/*.m
          ../../fude/zoom/*.c      ../../fude/zoom/*.m
          ../../fude/sim/*.c
# A platform's own files are named after it. Android's (JNI) are out everywhere else; [macos] and [android] say theirs.
exclude = ../../fude/**/*_android.c ../../fude/drawing/base/android.c
include = ../../fude src
# A call to a function nothing declares is an error: C would guess its type.
flags   = -Wall -Wextra -Werror=implicit-function-declaration
# Its own, which InfiNote and InfiniWorkshop share (the fonts, the parts' drawings).
assets  = assets/
output  = ../../build/sketching/
default_profile = debug

[macos]
exclude   += ../../fude/**/*_ios.m
# AVFoundation, CoreMedia, CoreVideo: the canvas records and exports video (video_apple.m).
frameworks = CoreFoundation CoreGraphics ImageIO Foundation PDFKit CoreText AVFoundation CoreMedia CoreVideo
# Speech to text (fude/zoom/listen.h): whisper.cpp, built by tools/whisper/build.sh. Its headers as a system's: their
# own warnings are not this app's.
define.FUDE_WHISPER = 1
flags     += -isystem../../build/whisper/include
link_flags = -L../../build/whisper/mac/lib -lwhisper -lggml -lggml-cpu -lggml-base -lc++
# A Mac package (`builder package`): not released, but RDE's test plan packages one (its part C).
bundle_id  = com.rde.sketching
app_name   = Sketching
icon       = platform/ios/Assets.xcassets/AppIcon.appiconset/AppIcon-1024.png

[windows]
exclude += ../../fude/**/*.m

[android]
exclude      = ../../fude/**/*.m        # (=: Android's own files are back in)
output       = ../../build/sketching-android/
package_name = com.rde.sketching
app_name     = Sketching
icon         = platform/ios/Assets.xcassets/AppIcon.appiconset/AppIcon-1024.png
api_level    = 37
abis         = armv8a
java         = ../../fude/android/java
# ML Kit, pinned. No `dependencies`: the lock has lines added by hand, which the builder's resolver would drop.
dependencies_lock = platform/android/deps.lock
dependency_cache  = ../../build/android_deps
# The network: ML Kit's model (WAKE_LOCK: its downloads). The microphone: recordings synced to the ink. No camera:
# a document is scanned by Google's scanner, which runs in Play services and asks for its own.
permissions   = internet network_state wake_lock microphone
file_provider = true
# Speech to text, as on the Mac: whisper's and ggml's shared libraries, and the CPU's code once per ARM generation
# (the app loads the best its CPU runs). The list is tools/whisper/build.sh's.
define.FUDE_WHISPER = 1
flags     += -isystem../../build/whisper/include
link_flags = -L../../build/whisper/android-arm64/lib -lwhisper -lggml -lggml-base -lc++_shared
libs       = ../../build/whisper/android-arm64/lib/libwhisper.so
             ../../build/whisper/android-arm64/lib/libggml.so
             ../../build/whisper/android-arm64/lib/libggml-base.so
             ../../build/whisper/android-arm64/lib/libggml-cpu-android_armv8.0_1.so
             ../../build/whisper/android-arm64/lib/libggml-cpu-android_armv8.2_1.so
             ../../build/whisper/android-arm64/lib/libggml-cpu-android_armv8.2_2.so
             ../../build/whisper/android-arm64/lib/libggml-cpu-android_armv8.6_1.so
             ../../build/whisper/android-arm64/lib/libggml-cpu-android_armv9.0_1.so
             ../../build/whisper/android-arm64/lib/libggml-cpu-android_armv9.2_1.so
             ../../build/whisper/android-arm64/lib/libggml-cpu-android_armv9.2_2.so

[ios]
package_name      = com.rde.sketching
app_name          = Sketching
plist             = platform/ios/Info.plist
asset_catalog     = platform/ios/Assets.xcassets
launch_storyboard = platform/ios/LaunchScreen.storyboard
bundles           = platform/ios/localized
# What the app asks for through RDE, the microphone (audio synced to ink): RDE's iOS code for it is built only when
# named here, and the builder checks that the plist has its purpose string.
permissions       = microphone
# The system's frameworks the .m files use, besides those RDE links itself. (No whisper on iOS yet: the app hides
# its transcription there, fude/zoom/listen.h.)
link_flags = -framework PhotosUI -framework ImageIO -framework VisionKit -framework PDFKit -framework CoreText
             -framework AVFoundation -framework CoreMedia -framework CoreVideo

# The Mac's: the developer's build, which reads the look flags (COMMANDS.txt).
[profile debug]
config = debug

# A release takes no launch arguments.
[profile release]
config = release

# A release that does, to measure it (--perf, --gate). Never shipped: it has a folder of its own.
[profile measure : release]
define.FUDE_ALLOW_ARGS =
output = ../../build/sketching-measure/

[profile android]
platform = android
config   = release

# Google Play's App Bundle.
[profile bundle : android]
aab = true

# A release APK that takes launch arguments, to measure it on a tablet (--perf, --gate: RDE's activity reads them
# from `adb shell am start ... --esa args`). Never shipped. An app of its own, beside the real one: its own id, so
# its own empty saves (a measuring run draws into the canvas that is open), and its own key, made by the builder.
[profile android-measure : android]
define.FUDE_ALLOW_ARGS =
output       = ../../build/sketching-android-measure/
package_name = com.rde.sketching_measure
app_name     = "Sketching (measure)"

# The iPad's, signed (FUDE_IOS_PROFILE: tools/build/app.sh). ML Kit (tools/mlkit/setup.py makes third_party/mlkit):
# its handwriting reader alone, for the lasso's To text and Find. A device's only: the Simulator has no ML Kit.
[profile ios]
platform    = ios
config      = release
output      = ../../build/sketching-ios/
frameworks  = ../../third_party/mlkit/frameworks/MLKitDigitalInkRecognition.framework
              ../../third_party/mlkit/frameworks/MLKitCommon.framework
              ../../third_party/mlkit/frameworks/MLKitMDD.framework
bundles    += ../../third_party/mlkit/bundles
include    += ../../third_party/mlkit/include
link_flags += -L../../third_party/mlkit/lib -lmlkit_deps -lz -lsqlite3 -liconv

# The Simulator's: debug, for the look flags (the store's screenshots).
[profile sim]
platform = ios_simulator
config   = debug
output   = ../../build/sketching-simulator/
